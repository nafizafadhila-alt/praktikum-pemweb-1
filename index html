    <section id="form-tambah">
        <h2>Tambah Mahasiswa Baru</h2>
        <p>Isi formulir berikut untuk menambahkan data mahasiswa baru.</p>

        <form action="#" method="POST">
             <fieldset>

                <legend>Data Mahasiswa</legend>

                     <p>
                    <label for="npm">Nomor Pokok Mahasiswa (NPM)</label><br>

                     <input type="text" id="npm" name="npm"
                      placeholder="Contoh : 2455061011"
                      required
                      pattern="[0-9]{8,12}"
                      title="NPM harus berupa angka 8-12 digit"><br>
                      <small>Isi dengan angka 8-12 digit.</small>
                    </p>
                    
                    <p>
                        <label for="nama">Nama Lengkap:</label><br>
                        <input type="text" id="nama" name="nama"
                        placeholder="Contoh : Nafiza Fadhila Hasanah"
                        required
                        minlength="3"
                        maxlength="100"><br>
                        <small>Minimal 3 karakter, maksimal 100 karakter.</small>
                    </p>
                    
                    <p>
                        <label for="program_studi">Program Studi:</label><br>
                        <select id="program_studi" name="program_studi" required>
                            <option value="">Pilih Program Studi</option>
                            <option value="Teknik Informatika">Teknik Informatika</option>
                        </select><br>
                        <small>Pilih salah satu program studi.</small>
                    </p>
 
                    <p>
                        <label for="angkatan">Tahun Angkatan:</label><br>
                        <input type="number" id="angkatan" name="angkatan"
                        placeholder="Contoh : 2024"
                        required
                        min="2018"
                        max="2026"><br>
                        <small>Isi tahun antara 2018 sampai 2026.</small>
                    </p>
                    
                    <p>
                        <label for="email">Alamat Email:</label><br>
                        <input type="email" id="email" name="email"
                        placeholder="Contoh : email@example.com"
                        required><br>
                        <small>Gunakan format email yang benar.</small>
                    </p>

                    <p>
                        <button type="submit">Simpan Data Mahasiswa</button>
                        <button type="reset">Reset Formulir</button>
                    </p>
                </fieldset>
            </form>
        </section>
